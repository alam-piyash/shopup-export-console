# Postgres connection string. On Supabase use the pooler in transaction mode (port 6543):
# Supabase > Connect > Transaction pooler. URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.YOUR-REF:YOUR-PASSWORD@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
# Supabase > Project Settings > API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Optional. Only for projects still signing tokens with the legacy HS256 secret
# (Supabase > Project Settings > JWT Keys). Without it the API reads the public keys (JWKS)
# or asks Supabase Auth to confirm the token.
SUPABASE_JWT_SECRET=
# Optional, default "documents"
STORAGE_BUCKET=documents
# Optional, default 8080 (Vercel sets PORT itself)
PORT=8080
