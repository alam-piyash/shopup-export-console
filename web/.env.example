# Supabase > Project Settings > API. Used only for Google sign-in in the browser.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
# Google Workspace domains allowed to sign in (must match app_settings in the database)
NEXT_PUBLIC_ALLOWED_DOMAIN=shopup.org,silq.net
# Local development only: where the Go API runs (Vercel routes /api to the Go service itself)
API_DEV_URL=http://127.0.0.1:8080
